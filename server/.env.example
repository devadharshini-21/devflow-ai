PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/devflow-ai?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Client URL
CLIENT_URL=http://localhost:5173

# Google Authentication (OAuth 2.0 Client ID)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Email Configuration (Nodemailer SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_specific_password
EMAIL_FROM="DevFlow AI" <no-reply@devflow.ai>
